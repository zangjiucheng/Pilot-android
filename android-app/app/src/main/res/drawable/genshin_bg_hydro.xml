<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="330"
                android:endColor="#8CE0FF"
                android:startColor="#152640"
                android:type="linear" />
        </shape>
    </item>
    <item android:gravity="center_horizontal|bottom">
        <shape android:shape="oval">
            <size android:width="420dp" android:height="220dp" />
            <gradient
                android:centerColor="#88A4EEFF"
                android:endColor="#00A4EEFF"
                android:startColor="#00A4EEFF"
                android:type="radial"
                android:gradientRadius="220dp" />
        </shape>
    </item>
</layer-list>
