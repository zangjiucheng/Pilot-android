<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="325"
                android:endColor="#D9E8FF"
                android:startColor="#233052"
                android:type="linear" />
        </shape>
    </item>
    <item android:gravity="bottom|start">
        <shape android:shape="oval">
            <size android:width="360dp" android:height="360dp" />
            <gradient
                android:centerColor="#80CFE0FF"
                android:endColor="#00CFE0FF"
                android:startColor="#00CFE0FF"
                android:type="radial"
                android:gradientRadius="200dp" />
        </shape>
    </item>
</layer-list>
